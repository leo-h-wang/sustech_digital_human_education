# Enforce LF line endings for text files (cross-platform, avoids noisy diffs)
* text=auto

# Common source/code/document formats
*.py   text eol=lf
*.pyi  text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.txt  text eol=lf
*.sh   text eol=lf
*.ps1  text eol=lf


