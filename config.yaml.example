# 配置文件示例
# 复制此文件为 config.yaml 并填入实际配置

# LLM 提供商配置
llm:
  provider: "tongyi"  # 可选: tongyi, spark, kimi
  api_key: ""  # 从环境变量 TONGYI_API_KEY 读取，或在此填写
  
# API 配置
api:
  timeout: 60  # 请求超时时间（秒）
  max_tokens: 3000  # 最大 token 数
  
# PDF 配置
pdf:
  page_size: "A4 landscape"  # 页面大小
  margin: "2cm"  # 页边距
  
# 调试配置
debug:
  print_prompts: false  # 是否打印发送给 LLM 的 prompt
  save_responses: true  # 是否保存 LLM 响应

